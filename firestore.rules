rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Membership is provisioned manually in Firebase Console or via the Admin SDK,
    // and bootstrapped for the project owner.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'locollinet@gmail.com' &&
        request.auth.token.email_verified == true;
    }
    function memberPath() {
      return /databases/$(database)/documents/familyAccess/$(request.auth.uid);
    }
    function isMember() {
      return isAdmin() || (
        request.auth != null && exists(memberPath()) &&
        get(memberPath()).data.role in ['viewer', 'editor', 'admin']
      );
    }
    function isEditor() {
      return isAdmin() || (
        request.auth != null && exists(memberPath()) &&
        get(memberPath()).data.role in ['editor', 'admin']
      );
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function validPhoto(data, id) {
      return data.keys().hasAll(['personId', 'photoDataUrl', 'updatedAt'])
        && data.keys().hasOnly(['personId', 'photoDataUrl', 'updatedAt', 'shape', 'filter', 'caption', 'uploadedBy'])
        && data.personId == id && isValidId(id)
        && data.photoDataUrl is string && data.photoDataUrl.size() >= 10 && data.photoDataUrl.size() <= 500000
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('shape' in data) || (data.shape is string && data.shape.size() <= 32))
        && (!('filter' in data) || (data.filter is string && data.filter.size() <= 32))
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 256))
        && (!('uploadedBy' in data) || data.uploadedBy == request.auth.uid);
    }
    match /familyAccess/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }
    match /personPhotos/{personId} {
      allow get, list: if isMember();
      allow create, update: if isEditor() && validPhoto(request.resource.data, personId);
      allow delete: if isEditor() && isValidId(personId);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
