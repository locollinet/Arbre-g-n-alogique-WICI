rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: personPhotos
// Document ID: {personId} (alphanumeric, dash, underscore, 1..128 chars)
// Fields:
//   - personId: string (required, matches document ID)
//   - photoDataUrl: string (required, 10..500000 chars) - compressed image data URL
//   - updatedAt: string (required, <= 64 chars) - ISO timestamp
//   - shape: string (optional, <= 32 chars) - crop mask shape
//   - filter: string (optional, <= 32 chars) - visual filter
//   - caption: string (optional, <= 256 chars) - photo caption
//   - uploadedBy: string (optional, <= 128 chars) - author identifier
//
// Collection: familyArchive
// Document ID: {docId} (e.g. 'wici', alphanumeric, dash, underscore, 1..128 chars)
// Fields:
//   - people: list (required, 1..500 items) - shared family members array
//   - settings: map (optional) - shared tree visual settings
//   - updatedAt: string (required, <= 64 chars) - ISO timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function validPhoto(data, id) {
      return data.keys().hasAll(['personId', 'photoDataUrl', 'updatedAt'])
        && data.keys().hasOnly(['personId', 'photoDataUrl', 'updatedAt', 'shape', 'filter', 'caption', 'uploadedBy'])
        && data.personId == id && isValidId(id)
        && data.photoDataUrl is string && data.photoDataUrl.size() >= 10 && data.photoDataUrl.size() <= 500000
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('shape' in data) || (data.shape is string && data.shape.size() <= 32))
        && (!('filter' in data) || (data.filter is string && data.filter.size() <= 32))
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 256))
        && (!('uploadedBy' in data) || (data.uploadedBy is string && data.uploadedBy.size() <= 128));
    }

    function validArchive(data) {
      return data.keys().hasAll(['people', 'updatedAt'])
        && data.keys().hasOnly(['people', 'settings', 'updatedAt'])
        && data.people is list && data.people.size() >= 1 && data.people.size() <= 500
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('settings' in data) || data.settings is map);
    }

    match /personPhotos/{personId} {
      allow get, list: if true;
      allow create, update: if isValidId(personId) && validPhoto(request.resource.data, personId);
      allow delete: if isValidId(personId);
    }

    match /familyArchive/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId) && validArchive(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
